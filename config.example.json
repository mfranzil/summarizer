{
  "miniflux": {
    "base_url": "https://miniflux.example.com",
    "api_token": "replace-me"
  },
  "telegram": {
    "bot_token": "replace-me",
    "chat_id": "-1000000000000",
    "auto_create_topics": true
  },
  "category_icons": {},
  "state": {
    "path": "state/router-state.json"
  },
  "polling": {
    "interval_seconds": 300,
    "lookback_hours": 24,
    "page_limit": 500
  },
  "defaults": {
    "mode": "mute"
  },
  "policies": [
    {
      "feed_title": "Example feed",
      "mode": "direct"
    },
    {
      "feed_title": "Another example feed",
      "mode": "digest",
      "digest": {
        "window_hours": 4,
        "max_items": 25,
        "title": "Example digest",
        "similarity_threshold": 0.72
      }
    }
  ]
}
